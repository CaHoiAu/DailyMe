  - "Nh\u1EDB l\xE0 m\xF4n n\xE0o c\xF3 tr\u01B0\u1EDBc th\xEC \u0111\u1EC3 tr\xEAn
    c\xF9ng nh\xE1!"
  - "\u0110\u1EEBng c\xF3 qu\xEAn m\u1EA5y c\xE1i d\u1EE5ng c\u1EE5 h\u1ECDc t\u1EADp
    nha tr\u1EDDi. B\u1ECF v\xE0o c\u1EB7p th\xEC kh\xF3 m\xF2 qu\xE1..."
  - "B\u1EEFa nay h\u1EA1n ch\u1EBF u\u1ED1ng tr\xE0 s\u1EEFa nh\xE1!"
  - "\u0110em n\u01B0\u1EDBc l\u1ECDc theo \u0111\u1EC3 u\u1ED1ng thay tr\xE0 s\u1EEFa
